# Shared E2E config — sourced by the runners (requires $E2E_DIR to be set first).
# Override any value from the environment, e.g.  AVD=Pixel_9_API_36 ./e2e.sh
APP_ID="${APP_ID:-com.twofasapp.pass}"
AVD="${AVD:-Pixel_8_API_34}"
APK="${APK:-$E2E_DIR/app/twofas-pass-1.8.0.apk}"
MASTER_PASSWORD="${MASTER_PASSWORD:-testtesttest}"
