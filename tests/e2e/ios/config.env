# Shared iOS E2E config — sourced by the runners (requires $E2E_DIR to be set first).
# Override any value from the environment, e.g.  DEVICE_TYPE="iPhone 17" ./e2e.sh
APP_ID="${APP_ID:-com.twofas.org.TwoPASS.dev}"
DEVICE_NAME="${DEVICE_NAME:-2FAS-E2E}"
DEVICE_TYPE="${DEVICE_TYPE:-iPhone 16}"
IOS_RUNTIME="${IOS_RUNTIME:-com.apple.CoreSimulator.SimRuntime.iOS-26-4}"
APP="${APP:-$E2E_DIR/app/2FAS Pass.app}"
MASTER_PASSWORD="${MASTER_PASSWORD:-testtesttest}"
